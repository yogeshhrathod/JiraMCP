{
  "name": "jira-mcp-server-pro",
  "version": "2.0.0",
  "description": "MCP server for self-hosted Jira (PAT auth) with smart option matching, elicitation, prompts and resources",
  "main": "dist/index.js",
  "type": "module",
  "bin": {
    "jira-mcp-server-pro": "dist/index.js"
  },
  "files": [
    "dist/**/*",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "prepublishOnly": "npm run build",
    "test": "node --import tsx --test test/*.test.ts"
  },
  "keywords": [
    "mcp",
    "jira",
    "atlassian",
    "model-context-protocol",
    "jira-server",
    "elicitation"
  ],
  "license": "MIT",
  "author": "yogeshrathod",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yogeshhrathod/jiraMCP.git"
  },
  "bugs": {
    "url": "https://github.com/yogeshhrathod/jiraMCP/issues"
  },
  "homepage": "https://github.com/yogeshhrathod/jiraMCP#readme",
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.1.0",
    "dotenv": "^16.3.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.1.0",
    "@types/node": "^20.10.0",
    "tsx": "^4.6.2",
    "typescript": "^5.3.2"
  },
  "mcpName": "io.github.yogeshhrathod/jira-mcp-server-pro"
}
